{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun",
      "tscircuit"
    ]
  },
  "include": [
    "src/**/*.tsx",
    "tests/**/*.tsx"
  ]
}
